# zeit's shell integration. It hands your ZDOTDIR back, sources your .zshenv,
# and adds to interactive shells: shell marks (OSC 133) and the Enter hand-off
# that lets z.rule send a command to another pane.
if [[ -n "$ZEIT_ORIG_ZDOTDIR" ]]; then ZDOTDIR="$ZEIT_ORIG_ZDOTDIR"; else unset ZDOTDIR; fi
unset ZEIT_ORIG_ZDOTDIR
[[ -f "${ZDOTDIR:-$HOME}/.zshenv" ]] && source "${ZDOTDIR:-$HOME}/.zshenv"

if [[ -o interactive ]]; then
  autoload -Uz add-zsh-hook
  typeset -g _zeit_ran=0
  _zeit_precmd() {
    local s=$?
    (( _zeit_ran )) && print -n "\e]133;D;$s\a"
    _zeit_ran=0
    print -n "\e]133;A\a"
  }
  _zeit_preexec() { _zeit_ran=1; print -n "\e]133;C\a" }

  # Enter: when a rule sends the command elsewhere, this shell keeps one line for it
  _zeit_accept() {
    emulate -L zsh
    local cmd=$BUFFER r
    if [[ -e @RULES@ && -n ${cmd//[[:space:]]/} ]]; then
      r=$(@ZEIT@ __route -- "$cmd" 2>/dev/null)
      if [[ $r == routed\ * ]]; then
        print -s -- "$cmd"
        typeset -g _zeit_job=${r#routed } _zeit_job_cmd=$cmd
        BUFFER=''
      fi
    fi
    zle _zeit_orig_accept_line
  }
  _zeit_jobline() {
    [[ -n $_zeit_job ]] || return 0
    # over the empty prompt line the hand-off left
    print -n "\e[1A\e[2K\r\e]7733;job;$_zeit_job\a"
    local one=${_zeit_job_cmd%%$'\n'*}
    print -r -- "▸ ${one[1,COLUMNS-4]}"
    unset _zeit_job _zeit_job_cmd
  }

  # after .zshrc (plugins included), once: the hooks go first, Enter is wrapped
  _zeit_setup() {
    add-zsh-hook -d precmd _zeit_setup
    if (( ! ${+functions[_zash_precmd]} )); then
      precmd_functions=(_zeit_precmd ${precmd_functions:#_zeit_precmd})
      add-zsh-hook preexec _zeit_preexec
    fi
    precmd_functions=(${precmd_functions:#_zeit_jobline})
    precmd_functions=(${precmd_functions[1]} _zeit_jobline ${precmd_functions[2,-1]})
    zle -A accept-line _zeit_orig_accept_line
    zle -N accept-line _zeit_accept
    _zeit_precmd
  }
  add-zsh-hook precmd _zeit_setup
fi
